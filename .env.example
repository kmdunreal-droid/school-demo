# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATA MODE: "demo" (default) = app fully LOCAL (browser localStorage).
# "live" ya missing = Supabase/cloud sync on hota hai (tab adapter plug karein).
VITE_DATA_MODE="demo"

# Supabase (primary cloud backend — replaces Firebase)
VITE_SUPABASE_URL="https://ezggmokzscashorchsdw.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_0UnzsqCu5T4Hx4qPwFwe1A_cAAq3s7B"
# SECRET (service-role) — sirf server-side scripts ke liye (kabhi client mein nahi)
SUPABASE_SECRET_KEY="sb_secret_kj3ybIkGzO9_bkROd23r4w_fwD1USX7"
SUPABASE_JWKS_URL="https://ezggmokzscashorchsdw.supabase.co/auth/v1/.well-known/jwks.json"
